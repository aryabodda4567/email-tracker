{
    "version": 2,
    "builds": [
        {
            "src": "public/**",
            "use": "@vercel/static"
        },
        {
            "src": "app.js",
            "use": "@vercel/node"
        }
    ],
    "routes": [
        {
            "src": "/html/(.*)",
            "dest": "/public/html/$1"
        },
        {
            "src": "/css/(.*)",
            "dest": "/public/css/$1"
        },
        {
            "src": "/js/(.*)",
            "dest": "/public/js/$1"
        },
        {
            "src": "^/$",
            "status": 301,
            "headers": {
                "Location": "/html/dashboard.html"
            }
        },
        {
            "src": "/(.*)",
            "dest": "/app.js"
        }
    ]
}